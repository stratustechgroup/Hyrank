# Loops.so API Key for waitlist signups
# Get your API key from: https://app.loops.so/settings?page=api
# This key is kept server-side only (never exposed to the client)
LOOPS_API_KEY=your_loops_api_key_here

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Stripe Configuration (for premium subscriptions)
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# HyAuth Configuration (for Hytale player verification)
# Get from: https://hyauth.com/dashboard
HYAUTH_API_KEY=your_hyauth_key_here

# Cron Job Secret (for Vercel cron authorization)
CRON_SECRET=your_random_secret_here

# Vote Security
IP_SALT=your_random_salt_for_hashing_ips

# Site URL
NEXT_PUBLIC_URL=http://localhost:3000
